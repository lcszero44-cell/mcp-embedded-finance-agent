# ==============================================================================
# MCP Embedded Finance Agent — Environment Template (PLACEHOLDERS ONLY)
# Copie este arquivo para `.env` localmente. NUNCA versione `.env` no Git.
# ==============================================================================

# Plaid Sandbox Credentials (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=your_sandbox_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# Pluggy Docs MCP Server (Streamable HTTP — sem necessidade de API key)
PLUGGY_MCP_URL=https://mcp.pluggy.ai/mcp

# Taxa de câmbio declarada para conversão USD -> BRL no ambiente Sandbox
USD_TO_BRL_RATE=5.75

# Porta do backend local Express (desenvolvimento Etapa 2)
PORT=3001
